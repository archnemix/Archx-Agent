$ bash -c 
  curl -sS -H "Content-Type: application/json" --max-time 120 \
    -d "{\"model\":\"local\",\"messages\":[{\"role\":\"user\",\"content\":\"In one short sentence, what is a tunnel?\"}],\"max_tokens\":48}" \
    "http://127.0.0.1:$PORT/v1/chat/completions" > "$LOGDIR/completion.json"
  python - <<PY
import json, os, pathlib
data = json.loads(pathlib.Path(os.environ["LOGDIR"], "completion.json").read_text())
text = data["choices"][0]["message"]["content"].strip()
usage = data.get("usage", {})
print("text:", text)
print("usage:", usage)
assert text, "empty reply"
pathlib.Path(os.environ["LOGDIR"], "model-proof.json").write_text(json.dumps({"text": text, "usage": usage}, indent=2))
PY

text: A tunnel is a narrow, narrow passageway that connects two or more points, typically through an underground or undersea tunnel.
usage: {'completion_tokens': 26, 'prompt_tokens': 40, 'total_tokens': 66, 'prompt_tokens_details': {'cached_tokens': 0}}
