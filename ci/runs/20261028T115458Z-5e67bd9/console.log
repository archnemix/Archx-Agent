=== llama-cpp ===============================================
$ bash -c 
  set -u
  mkdir -p "$HOME/llama"; server=""
  for page in 1 2; do
    asset="$(gh api "repos/ggml-org/llama.cpp/releases?per_page=10&page=$page" \
      --jq ".[].assets[].browser_download_url" 2>/dev/null \
      | grep -E "/llama-b[0-9]+-bin-ubuntu-x64\.tar\.gz$" | head -1 || true)"
    [ -n "$asset" ] && break
  done
  if [ -n "${asset:-}" ]; then
    echo "prebuilt: $asset"
    curl -fsSL "$asset" -o /tmp/llama.tar.gz && tar -xzf /tmp/llama.tar.gz -C "$HOME/llama" || true
    server="$(find "$HOME/llama" -name llama-server -type f | head -1)"
  fi
  if [ -z "$server" ]; then
    echo "no prebuilt binary; building from source"
    git clone --depth 1 https://github.com/ggml-org/llama.cpp /tmp/llama-src
    cmake -S /tmp/llama-src -B /tmp/llama-src/build -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF
    cmake --build /tmp/llama-src/build --target llama-server -j "$(nproc)"
    server=/tmp/llama-src/build/bin/llama-server
  fi
  [ -x "$server" ] || { echo "no llama-server binary"; exit 1; }
  chmod +x "$server"; "$server" --version
  echo "LLAMA_SERVER=$server" >> "$GITHUB_ENV"

