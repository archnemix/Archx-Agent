$ bash -c 
  mkdir -p "$HOME/model"
  target="$HOME/model/$MODEL_FILE"
  if [ ! -s "$target" ]; then
    curl -fL --retry 3 -o "$target.part" \
      "https://huggingface.co/$MODEL_REPO/resolve/main/$MODEL_FILE"
    mv "$target.part" "$target"
  fi
  ls -lh "$target"
  head -c 4 "$target" | grep -q GGUF || { echo "not a GGUF file"; exit 1; }
  echo "MODEL_PATH=$target" >> "$GITHUB_ENV"

