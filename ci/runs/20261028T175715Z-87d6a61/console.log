=== serve ===============================================
$ bash -c 
  # Detach *all three* descriptors. A backgrounded server that inherits the closing
  # pipeline keeps the tee pipe open, so run.sh waits forever even after the check
  # here is done - the first run of this workflow hung on exactly this line.
  setsid "$LLAMA_SERVER" --model "$MODEL_PATH" --host 127.0.0.1 --port "$PORT" \
    --ctx-size 512 --n-gpu-layers 0 --threads 2 --parallel 1 \
    --no-warmup --log-file "$RUNNER_TEMP/llama.log" \
    > "$RUNNER_TEMP/llama.out" 2>&1 < /dev/null &
  echo $! > "$RUNNER_TEMP/llama.pid"
  for i in $(seq 1 180); do
    curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && { echo "up after ${i}s"; exit 0; }
    sleep 1
  done
  tail -40 "$RUNNER_TEMP/llama.log"; exit 1

