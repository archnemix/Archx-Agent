    | tee -a "$LOGDIR/console.log"
  # and through Archx itself: a keyless local daemon is the one case where a model
  # is ready with no credential, so this also proves that rule on a real daemon.
  export ARCHX_PATHS_HOME="$RUNNER_TEMP/archx-ollama"
  archx-agent init >/dev/null
  archx-agent models add-sdk --name ollama-local --sdk ollama \
    --model smollm2:135m --base-url http://127.0.0.1:11434
  archx-agent models probe ollama-local --capability chat
  archx-agent chat --stream --message "Name one colour." --model ollama-local

