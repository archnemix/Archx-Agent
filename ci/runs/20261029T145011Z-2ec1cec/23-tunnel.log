$ bash -c 
  set -u
  curl -fsSL -o "$RUNNER_TEMP/cloudflared" \
    https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
  chmod +x "$RUNNER_TEMP/cloudflared"
  "$RUNNER_TEMP/cloudflared" tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" \
    > "$RUNNER_TEMP/tunnel.log" 2>&1 &
  echo $! > "$RUNNER_TEMP/tunnel.pid"
  url=""
  for i in $(seq 1 90); do
    url="$(grep -oE "https://[a-z0-9-]+\.trycloudflare\.com" "$RUNNER_TEMP/tunnel.log" | head -1 || true)"
    [ -n "$url" ] && break; sleep 1
  done
  [ -n "$url" ] || { tail -40 "$RUNNER_TEMP/tunnel.log"; exit 1; }
  echo "url=$url" | tee "$LOGDIR/tunnel-url.txt"
  for i in $(seq 1 60); do
    curl -fsS --max-time 5 "$url/health" >/dev/null 2>&1 && break; sleep 2
  done
  code="$(curl -sS --max-time 60 -o "$LOGDIR/public.json" -w "%{http_code}" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"local\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":16}" \
    "$url/v1/chat/completions")"
  echo "public chat HTTP $code"; head -c 400 "$LOGDIR/public.json"
  [ "$code" = "200" ] || exit 1
  # and through a vendor SDK, over the public URL, from this runner
  python - "$url" <<PY
import sys
from openai import OpenAI
client = OpenAI(api_key="local-model-no-key", base_url=sys.argv[1] + "/v1")
reply = client.chat.completions.create(
    model="local", messages=[{"role": "user", "content": "Say hi in three words."}],
    max_tokens=24, timeout=90,
)
print("openai SDK via the public URL:", reply.choices[0].message.content.strip())
PY

url=https://holder-pro-teens-wednesday.trycloudflare.com
